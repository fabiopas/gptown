PORT=3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
API_KEY=local-dev-key

# Admin user — only used on first run to seed the database.
# After that, manage users through the admin panel in the UI.
UI_USER=admin
UI_PASSWORD=changeme

# Optional: custom path for the SQLite database file
# DB_PATH=./gptown.db
